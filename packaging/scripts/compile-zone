#!/bin/sh
set -eu

state_dir=${RGBDNS_STATE_DIR:-/var/lib/rgbdns/tinydns}
if [ -r /etc/rgbdns/tinydns.env ]; then
    # shellcheck disable=SC1091
    . /etc/rgbdns/tinydns.env
    export ACME_UPDATE_CONFIG ACME_STATE_DIR
fi
cd "$state_dir"
test -r data
umask 027
if [ -r /etc/rgbdns/dnssec.env ]; then
    # shellcheck disable=SC1091
    . /etc/rgbdns/dnssec.env
    : "${DNSSEC_POLICY:=/etc/rgbdns/dnssec}"
    test -r data.cdb
    exec /usr/bin/rgbsec-check data.cdb "$DNSSEC_POLICY"
fi
exec /usr/bin/tinydns-data

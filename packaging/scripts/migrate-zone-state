#!/bin/sh
set -eu

legacy=${RGBDNS_LEGACY_ZONES_FILE:-/etc/rgbdns/zones}
zones_file=${RGBDNS_ZONES_FILE:-/var/lib/rgbdns/tinydns/zones}
install_owner=${RGBDNS_INSTALL_OWNER:-root:rgbdns}
state_owner=${RGBDNS_STATE_OWNER:-rgbdns:rgbdns}

[ -e "$legacy" ] || exit 0
[ -f "$legacy" ] && [ ! -L "$legacy" ] || {
    echo "rgbdns-migrate-zone-state: legacy zone list is not a regular file: $legacy" >&2
    exit 1
}

zones_dir=${zones_file%/*}
install -d -o "${state_owner%:*}" -g "${state_owner#*:}" -m 0750 "$zones_dir"
stage=$(mktemp "$zones_dir/.zones-migrate.XXXXXX")
trap 'rm -f "$stage"' EXIT HUP INT TERM
cp "$legacy" "$stage"
chown "$install_owner" "$stage"
chmod 0640 "$stage"
mv -f "$stage" "$zones_file"
rm -f "$legacy"
trap - EXIT HUP INT TERM

echo "rgbdns-migrate-zone-state: moved the canonical zone list to $zones_file"

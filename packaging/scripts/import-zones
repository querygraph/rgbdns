#!/bin/sh
set -eu

: "${ZONES_DROP:?ZONES_DROP is required in /etc/rgbdns/zones-drop.env}"
: "${ZONES_DROP_OWNER:?ZONES_DROP_OWNER is required in /etc/rgbdns/zones-drop.env}"

zones_file=${RGBDNS_ZONES_FILE:-/etc/rgbdns/zones}
install_owner=${RGBDNS_INSTALL_OWNER-root:rgbdns}

case $ZONES_DROP in
    /*) ;;
    *) echo "rgbdns-import-zones: drop path must be absolute: $ZONES_DROP" >&2; exit 2 ;;
esac

[ -f "$ZONES_DROP" ] && [ ! -L "$ZONES_DROP" ] || {
    echo "rgbdns-import-zones: drop file is not a regular file: $ZONES_DROP" >&2
    exit 2
}

drop_owner=$(
    stat -c %U "$ZONES_DROP" 2>/dev/null ||
        stat -f %Su "$ZONES_DROP"
)
[ "$drop_owner" = "$ZONES_DROP_OWNER" ] || {
    echo "rgbdns-import-zones: $ZONES_DROP is owned by $drop_owner, expected $ZONES_DROP_OWNER" >&2
    exit 2
}

zones_dir=${zones_file%/*}
[ "$zones_dir" != "$zones_file" ] || zones_dir=.
mkdir -p "$zones_dir"
stage=$(mktemp "$zones_dir/.zones.XXXXXX")
trap 'rm -f "$stage"' EXIT HUP INT TERM
umask 027

line_number=0
while IFS= read -r line || [ -n "$line" ]; do
    line_number=$((line_number + 1))
    line=$(printf '%s\n' "$line" |
        sed 's/[[:space:]]*$//; s/^[[:space:]]*//')
    case $line in
        ''|'#'*) continue ;;
        *[[:space:]]*)
            echo "rgbdns-import-zones: line $line_number must contain one zone" >&2
            exit 2
            ;;
    esac

    zone=$(printf '%s' "${line%.}" | tr '[:upper:]' '[:lower:]')
    case $zone in
        ''|.|..|.*|*..*|*[!a-z0-9._-]*)
            echo "rgbdns-import-zones: invalid zone on line $line_number: $line" >&2
            exit 2
            ;;
    esac
    [ "${#zone}" -le 253 ] || {
        echo "rgbdns-import-zones: zone is too long on line $line_number" >&2
        exit 2
    }
    printf '%s\n' "$zone" |
        awk -F. '{
            for (i = 1; i <= NF; i++)
                if (length($i) < 1 || length($i) > 63)
                    exit 1
        }' || {
        echo "rgbdns-import-zones: invalid label on line $line_number: $line" >&2
        exit 2
    }

    grep -Fqx "$zone" "$stage" 2>/dev/null || printf '%s\n' "$zone" >>"$stage"
done <"$ZONES_DROP"

[ -s "$stage" ] || {
    echo "rgbdns-import-zones: drop file contains no zones" >&2
    exit 2
}

chmod 0640 "$stage"
if [ -n "$install_owner" ]; then
    chown "$install_owner" "$stage"
fi
mv -f "$stage" "$zones_file"
trap - EXIT HUP INT TERM

zone_count=$(wc -l <"$zones_file" | tr -d '[:space:]')
echo "rgbdns-import-zones: installed $zone_count zone(s) from $ZONES_DROP"

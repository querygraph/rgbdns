#!/bin/sh
set -eu

usage() {
    cat <<'EOF'
usage:
  rgbdns-setup primary --data FILE [options]
  rgbdns-setup secondary --zone NAME [--zone NAME ...]
                         --primary ADDRESS[:PORT] [options]

options:
  --listen-ip ADDRESS       authoritative listen address (default: 0.0.0.0)
  --port PORT               authoritative port (default: 53)
  --allow-nets CIDRS        enable AXFR for these secondary CIDRs
  --query-log BOOL          log each request (default: 1; use 0 to disable)
  --zone NAME               add a zone to transfer (repeatable)
  --zones "NAME ..."        add a whitespace- or comma-separated zone list
  --zones-drop FILE         watch an scp destination for a one-zone-per-line list
  --zones-drop-owner USER   require uploads to be owned by USER
  --no-start                write configuration without enabling services

The primary data file uses tinydns syntax. A secondary fetches every configured
zone into one managed data file and refreshes them every five minutes. By
default, sudo setup watches rgbdns.zones in the invoking user's home directory.
EOF
}

die() {
    echo "rgbdns-setup: $*" >&2
    exit 2
}

write_env() {
    file=$1
    shift
    umask 027
    : >"$file"
    for assignment do
        case $assignment in
            *'
'*) die "environment values must not contain newlines" ;;
        esac
        printf '%s\n' "$assignment" >>"$file"
    done
    chmod 0640 "$file"
    chown root:rgbdns "$file"
}

[ $# -gt 0 ] || { usage >&2; exit 2; }
case $1 in
    -h|--help) usage; exit 0 ;;
esac
[ "$(id -u)" -eq 0 ] || die "run as root"
role=$1
shift

listen_ip=0.0.0.0
port=53
allow_nets=
query_log=1
data_file=
zones=
primary=
zones_drop=
zones_drop_owner=${SUDO_USER:-root}
start=yes

while [ $# -gt 0 ]; do
    option=$1
    shift
    case $option in
        --listen-ip|--port|--allow-nets|--query-log|--data|--zone|--zones|--primary|--zones-drop|--zones-drop-owner)
            [ $# -gt 0 ] || die "$option requires a value"
            value=$1
            shift
            case $option in
                --listen-ip) listen_ip=$value ;;
                --port) port=$value ;;
                --allow-nets) allow_nets=$value ;;
                --query-log) query_log=$value ;;
                --data) data_file=$value ;;
                --zone) zones="${zones}${zones:+ }$value" ;;
                --zones)
                    value=$(printf '%s' "$value" | tr ',' ' ')
                    zones="${zones}${zones:+ }$value"
                    ;;
                --primary) primary=$value ;;
                --zones-drop) zones_drop=$value ;;
                --zones-drop-owner) zones_drop_owner=$value ;;
            esac
            ;;
        --no-start) start=no ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $option" ;;
    esac
done

case $port in
    *[!0-9]*|'') die "port must be a decimal integer" ;;
esac
[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "invalid port: $port"
case $(printf '%s' "$query_log" | tr '[:upper:]' '[:lower:]') in
    1|true|yes|on) query_log=1 ;;
    0|false|no|off) query_log=0 ;;
    *) die "query log must be 1 or 0" ;;
esac

normalized_zones=
for supplied_zone in $zones; do
    zone=$(printf '%s' "${supplied_zone%.}" | tr '[:upper:]' '[:lower:]')
    case $zone in
        ''|.|..|.*|*..*|*[!a-z0-9._-]*)
            die "invalid zone name: $supplied_zone"
            ;;
    esac
    case " $normalized_zones " in
        *" $zone "*) ;;
        *) normalized_zones="${normalized_zones}${normalized_zones:+ }$zone" ;;
    esac
done
zones=$normalized_zones

if [ -z "$zones_drop" ]; then
    zones_home=$(getent passwd "$zones_drop_owner" | cut -d: -f6)
    [ -n "$zones_home" ] ||
        die "cannot determine home directory for zones drop owner: $zones_drop_owner"
    zones_drop=$zones_home/rgbdns.zones
fi
case $zones_drop in
    /*) ;;
    *) die "zones drop path must be absolute: $zones_drop" ;;
esac
case $zones_drop in
    *[!A-Za-z0-9_./-]*) die "zones drop path contains unsupported characters: $zones_drop" ;;
esac
getent passwd "$zones_drop_owner" >/dev/null 2>&1 ||
    die "zones drop owner does not exist: $zones_drop_owner"

getent group rgbdns >/dev/null 2>&1 ||
    groupadd --system rgbdns
getent passwd rgbdns >/dev/null 2>&1 ||
    useradd --system --gid rgbdns --home-dir /var/lib/rgbdns \
        --shell /usr/sbin/nologin --comment "rgbdns service" rgbdns

install -d -o root -g rgbdns -m 0750 /etc/rgbdns
install -d -o rgbdns -g rgbdns -m 0750 /var/lib/rgbdns/tinydns
if [ -n "$allow_nets" ]; then
    write_env /etc/rgbdns/tinydns.env \
        "IP=$listen_ip" "PORT=$port" \
        "DATA=/var/lib/rgbdns/tinydns/data.cdb" \
        "QUERY_LOG=$query_log" \
        "ALLOW_NETS=$allow_nets"
else
    write_env /etc/rgbdns/tinydns.env \
        "IP=$listen_ip" "PORT=$port" \
        "DATA=/var/lib/rgbdns/tinydns/data.cdb" \
        "QUERY_LOG=$query_log"
fi

case $role in
    primary)
        [ -n "$data_file" ] || die "primary requires --data FILE"
        [ -r "$data_file" ] || die "cannot read data file: $data_file"
        install -o rgbdns -g rgbdns -m 0640 "$data_file" /var/lib/rgbdns/tinydns/data
        rm -f /etc/rgbdns/secondary.env /etc/rgbdns/zones \
            /etc/rgbdns/zones-drop.env
        rm -rf /etc/systemd/system/rgbdns-zones.path.d
        runuser -u rgbdns -- /usr/lib/rgbdns/compile-zone
        ;;
    secondary)
        [ -n "$zones" ] || die "secondary requires at least one --zone NAME"
        [ -n "$primary" ] || die "secondary requires --primary ADDRESS[:PORT]"
        write_env /etc/rgbdns/secondary.env "PRIMARY=$primary"
        zones_stage=$(mktemp /etc/rgbdns/.zones.XXXXXX)
        trap 'rm -f "$zones_stage"' EXIT HUP INT TERM
        for zone in $zones; do
            printf '%s\n' "$zone" >>"$zones_stage"
        done
        chown root:rgbdns "$zones_stage"
        chmod 0640 "$zones_stage"
        mv -f "$zones_stage" /etc/rgbdns/zones
        trap - EXIT HUP INT TERM
        write_env /etc/rgbdns/zones-drop.env \
            "ZONES_DROP=$zones_drop" "ZONES_DROP_OWNER=$zones_drop_owner"
        install -d -m 0755 /etc/systemd/system/rgbdns-zones.path.d
        {
            printf '%s\n' '[Path]' 'PathChanged='
            printf 'PathChanged=%s\n' "$zones_drop"
        } >/etc/systemd/system/rgbdns-zones.path.d/path.conf
        chmod 0644 /etc/systemd/system/rgbdns-zones.path.d/path.conf
        ;;
    *) die "role must be primary or secondary" ;;
esac

systemctl daemon-reload
[ "$start" = yes ] || exit 0

if [ "$role" = secondary ]; then
    systemctl disable --now rgbdns-secondary-sync.timer >/dev/null 2>&1 || true
    systemctl disable --now rgbdns-zones.path >/dev/null 2>&1 || true
    systemctl start rgbdns-secondary-sync.service
    systemctl enable rgbdns-secondary-sync.timer
    systemctl enable rgbdns-zones.path
else
    systemctl disable --now rgbdns-secondary-sync.timer >/dev/null 2>&1 || true
    systemctl disable --now rgbdns-zones.path >/dev/null 2>&1 || true
fi
systemctl enable rgbdns-tinydns.service
systemctl restart rgbdns-tinydns.service
if [ "$role" = secondary ]; then
    systemctl start rgbdns-secondary-sync.timer
    systemctl start rgbdns-zones.path
fi

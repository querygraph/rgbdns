#!/bin/sh
set -eu

config=${RGBDNS_REPORT_CONFIG:-/etc/rgbdns/query-report.env}
state_dir=${RGBDNS_STATE_DIR:-/var/lib/rgbdns/tinydns}
analyzer=${RGBDNS_LOG_REPORT:-/usr/bin/rgbdns-log-report}
journalctl=${RGBDNS_JOURNALCTL:-journalctl}

[ -r "$config" ] || {
    echo "rgbdns daily query report: cannot read $config" >&2
    exit 100
}
. "$config"

: "${REPORT_TO:?REPORT_TO is required in $config}"
sendmail=${REPORT_SENDMAIL:-/usr/sbin/sendmail}
[ -x "$sendmail" ] || {
    echo "rgbdns daily query report: sendmail is not executable: $sendmail" >&2
    exit 100
}

case $REPORT_TO in
    *[!A-Za-z0-9_@.+,=-]*|'')
        echo "rgbdns daily query report: invalid REPORT_TO" >&2
        exit 100
        ;;
esac

today=${RGBDNS_TODAY:-$(date +%F)}
report_date=${RGBDNS_REPORT_DATE:-$(date --date=yesterday +%F)}
zones=$(mktemp)
body=$(mktemp)
html_body=$(mktemp)
trap 'rm -f "$zones" "$body" "$html_body"' EXIT HUP INT TERM
chmod 0600 "$zones" "$body"
chmod 0600 "$html_body"

if [ -s "$state_dir/zones" ]; then
    cp "$state_dir/zones" "$zones"
elif [ -s "$state_dir/data" ]; then
    sed -n 's/^Z\([^:]*\):.*/\1/p' "$state_dir/data" >"$zones"
else
    echo "rgbdns daily query report: no zone source in $state_dir" >&2
    exit 100
fi
[ -s "$zones" ] || {
    echo "rgbdns daily query report: zone list is empty" >&2
    exit 100
}

"$journalctl" --quiet --unit=rgbdns-tinydns.service --output=cat \
    --since "$report_date 00:00:00" --until "$today 00:00:00" |
    "$analyzer" --zones "$zones" --date "$report_date" >"$body"

sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' "$body" >"$html_body"

if [ -n "${REPORT_FROM:-}" ]; then
    from=$REPORT_FROM
else
    if command -v hostname >/dev/null 2>&1; then
        report_host=$(hostname -f 2>/dev/null || hostname)
    elif [ -r /proc/sys/kernel/hostname ]; then
        IFS= read -r report_host </proc/sys/kernel/hostname
    else
        report_host=$(uname -n)
    fi
    from=rgbdns@$report_host
fi
subject="rgbdns daily query report for $report_date"
boundary="rgbdns-report-$$-$(date +%s)"
{
    printf 'To: %s\n' "$REPORT_TO"
    printf 'From: %s\n' "$from"
    printf 'Subject: %s\n' "$subject"
    printf 'Date: %s\n' "$(date -R)"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: multipart/alternative; boundary="%s"\n' "$boundary"
    printf 'Auto-Submitted: auto-generated\n'
    printf '\n'
    printf -- '--%s\n' "$boundary"
    printf 'Content-Type: text/plain; charset=UTF-8; format=fixed\n'
    printf 'Content-Transfer-Encoding: 8bit\n'
    printf '\n'
    cat "$body"
    printf '\n--%s\n' "$boundary"
    printf 'Content-Type: text/html; charset=UTF-8\n'
    printf 'Content-Transfer-Encoding: 8bit\n'
    printf '\n'
    printf '<!doctype html><html><body><pre style="font-family: monospace;">\n'
    cat "$html_body"
    printf '</pre></body></html>\n'
    printf -- '--%s--\n' "$boundary"
} | "$sendmail" -t

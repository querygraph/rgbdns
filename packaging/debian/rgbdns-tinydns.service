[Unit]
Description=rgbdns authoritative DNS server
Documentation=https://github.com/querygraph/rgbdns
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rgbdns
Group=rgbdns
EnvironmentFile=-/etc/rgbdns/tinydns.env
WorkingDirectory=/var/lib/rgbdns/tinydns
ExecStartPre=/usr/bin/test -r /var/lib/rgbdns/tinydns/data.cdb
ExecStart=/usr/bin/tinydns
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/rgbdns/tinydns

[Install]
WantedBy=multi-user.target
